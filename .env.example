# LLM
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash

# Embedding
DASHSCOPE_API_KEY=your-dashscope-api-key
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# RAG
RAG_ENABLED=true
RAG_TOP_K=3
RAG_MIN_SCORE=0.0

# Celery
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Safety / Governance
SAFETY_ENABLED=true
TOOL_PERMISSIONS_ENABLED=true
ALLOWED_TOOL_PERMISSIONS=read_page_dsl,read_write_page_dsl

# Audit
AUDIT_LOG_PATH=data/audit/agent_audit.jsonl

# LangSmith (optional)
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=page-generator-agent
